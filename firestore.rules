rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(data) { return signedIn() && request.auth.uid == data.coachId; }
    function validLink(id) {
      return id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
    }
    match /trainees/{traineeId} {
      allow read, delete: if owns(resource.data);
      allow create: if signedIn() && request.resource.data.coachId == request.auth.uid;
      allow update: if owns(resource.data) && request.resource.data.coachId == resource.data.coachId;
    }
    match /hc_live_sessions/{sessionId} {
      // The secret UUID grants access to this shared document, never collection listing.
      // Keep coach-only notes in /private, not in this shared document.
      allow get: if validLink(sessionId) || owns(resource.data);
      allow list: if owns(resource.data);
      allow create: if validLink(sessionId) && signedIn()
                    && request.resource.data.coachId == request.auth.uid;
      allow delete: if owns(resource.data);
      allow update: if owns(resource.data)
                    && request.resource.data.coachId == resource.data.coachId;
      function validIntensity(value) {
        return value == null || (value is number && value >= 1 && value <= 10);
      }
      function participantProgress() {
        let next = request.resource.data;
        let changed = next.diff(resource.data).affectedKeys();
        return validLink(sessionId)
          && resource.data.status == 'active'
          && changed.hasOnly(['environment', 'archetype', 'resourceArchetype', 'trigger',
                              'answers', 'blockerStrengthBefore', 'blockerStrengthAfter',
                              'participantPause', 'phase', 'status', 'completedAt'])
          && next.phase is int && next.phase >= 0 && next.phase <= 20
          && next.get('participantPause', false) is bool
          && next.get('answers', {}) is map
          && (next.get('environment', null) == null || next.environment is string)
          && (next.get('archetype', null) == null || next.archetype is string)
          && (next.get('resourceArchetype', null) == null || next.resourceArchetype is string)
          && (next.get('trigger', null) == null || next.trigger is string)
          && validIntensity(next.get('blockerStrengthBefore', null))
          && validIntensity(next.get('blockerStrengthAfter', null))
          && ((next.status == 'active' && !changed.hasAny(['completedAt']))
              || (next.status == 'completed' && next.completedAt == request.time));
      }
      function participantSummaryAmendment() {
        let next = request.resource.data;
        let changed = next.diff(resource.data).affectedKeys();
        return validLink(sessionId)
          && resource.data.status == 'completed'
          && changed.hasOnly(['answers', 'blockerStrengthAfter', 'participantPause'])
          && next.get('participantPause', false) is bool
          && validIntensity(next.get('blockerStrengthAfter', null))
          && next.get('answers', {}) is map
          && next.get('answers', {}).diff(resource.data.get('answers', {})).affectedKeys()
             .hasOnly(['homework', 'resource_reflection']);
      }
      allow update: if participantProgress() || participantSummaryAmendment();
      match /private/{documentId} {
        allow read, write: if owns(get(/databases/$(database)/documents/hc_live_sessions/$(sessionId)).data);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
